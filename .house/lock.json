          {
            "path": "plugins/house/agents/**",
            "why": "subagent definitions the harness loads; their tokens name tools and models, not this tree"
          },
          {
            "path": "plugins/house/orchestration/**",
            "why": "session-start context the hook injects; its tokens name agents and tiers, not this tree"
          },
          {
            "path": "docs/handbook/sources/**",
            "why": "package-authored survey material; its tokens describe surveyed repos, not this tree"
          },
          {
            "path": "research/**",
            "why": "point-in-time research records kept verbatim; their tokens describe surveyed repos and past states, not this tree"
          },
          "docs/handbook/claude-code.md",
          "docs/handbook/conventions.md",
          "docs/handbook/data-pipelines.md",
          "docs/handbook/database.md",
