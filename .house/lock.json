          {
            "path": "plugins/house/orchestration/**",
            "why": "session-start context the hook injects; its tokens name agents and tiers, not this tree"
          },
          {
            "path": "docs/handbook/sources/**",
            "why": "package-authored survey material; its tokens describe surveyed repos, not this tree"
          },
