{
  "name": "testing",
  "default": "on",
  "rules": [
    "rules/testing.md"
  ],
  "files": [],
  "configSlots": [
    "testGlobs",
    "gateGlobs",
    {
      "name": "testRoots",
      "default": [
        "**/tests/**",
        "**/test/**",
        "**/*.test.*",
        "**/*.spec.*"
      ]
    }
  ],
  "defaultPaths": [
    "$testRoots",
    "$testGlobs",
    "$gateGlobs"
  ]
}
