#!/usr/bin/env bash
# house branch guard, pre-push half of the floor.
#
# Managed by house: `house render` writes this file and .house/lock.json
# records it, so a local edit is reported as tamper.
#
# Refuses a push that would update or delete a protected branch on a remote
# when house.json asks for the `pr` branch policy. git has already expanded
# every refspec, alias and `push.default` into the ref lines on stdin, so the
# refs here are facts, not a reading of the command. See ADR 0013 and #58.
#
# Arguments: <remote-name> <remote-url>.
# Stdin:     <local-ref> <local-sha> <remote-ref> <remote-sha>, one per ref.
set -u

LIB="${HOUSE_GITHOOKS_DIR:-$(cd "$(dirname "$0")/.." && pwd)}/house-lib.sh"
if [ ! -r "$LIB" ]; then
  printf 'house pre-push: cannot read %s; refusing rather than guessing.\n' "$LIB" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$LIB"

top=$(house_toplevel) || exit 0
# shellcheck disable=SC2034 # read by house_refuse in house-lib.sh
HOUSE_TOPLEVEL="$top"

rc=0
house_manifest_read "$top" || rc=$?
[ "$rc" -eq 1 ] && exit 0
[ "$rc" -eq 2 ] && exit 1
[ "$HOUSE_POLICY" = "pr" ] || exit 0

# True when a sha is git's all-zeros placeholder (40 or 64 hex digits of 0),
# which means "does not exist": on the local side a deletion, on the remote
# side a branch this push would create.
is_zero_sha() {
  case "$1" in
    "" | *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

# Collected as an array, with its own counter: bash 3.2 under `set -u` treats
# ${#a[@]} on an empty array as unbound, so the count is tracked separately.
refused=()
refused_n=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  # Tags and anything that is not a branch on the remote are not this policy's
  # business; the floor protects branches.
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  branch="${remote_ref#refs/heads/}"
  house_is_protected "$branch" || continue

  if is_zero_sha "$local_sha"; then
    refused[refused_n]="$remote_ref (deleting a protected branch)"
    refused_n=$((refused_n + 1))
    continue
  fi

  if is_zero_sha "$remote_sha"; then
    # Creating the protected branch on the remote: there is no base to diff
    # against, so a carve-out cannot be established.
    refused[refused_n]="$remote_ref (creating a protected branch on the remote)"
    refused_n=$((refused_n + 1))
    continue
  fi

  # A remote sha this clone does not have cannot be diffed, so the carve-out
  # cannot be established and the push is refused: the direction this check is
  # allowed to fail in.
  if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    refused[refused_n]="$remote_ref (the remote's commit $remote_sha is not in this clone, so the carve-outs cannot be checked)"
    refused_n=$((refused_n + 1))
    continue
  fi

  changed=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || printf '')
  house_carve_out_satisfied "$changed" && continue
  refused[refused_n]="$remote_ref (from ${local_ref:-HEAD})"
  refused_n=$((refused_n + 1))
done

[ "$refused_n" -eq 0 ] && exit 0

house_refuse "pre-push" \
  "a push that would move a protected branch on remote '${1:-origin}':" \
  "${refused[@]}"
exit 1
