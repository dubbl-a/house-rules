{
  "name": "claude-code",
  "default": "on",
  "rules": [
    "rules/claude-code.md"
  ],
  "files": [
    {
      "src": "files/check-deep-research-upstream.mjs",
      "dest": "scripts/house/check-deep-research-upstream.mjs"
    }
  ],
  "configSlots": [
    "claudeWorkflowGlobs",
    {
      "name": "claudeGlobs",
      "default": [
        ".claude/**",
        "CLAUDE.md"
      ]
    }
  ],
  "defaultPaths": [
    "$claudeGlobs",
    "$claudeWorkflowGlobs"
  ]
}
