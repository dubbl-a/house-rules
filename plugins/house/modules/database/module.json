{
  "name": "database",
  "default": "detect",
  "detectPaths": [
    "db/",
    "migrations/"
  ],
  "rules": [
    "rules/database.md"
  ],
  "files": [],
  "configSlots": [
    {
      "name": "dbGlobs",
      "default": [
        "db/**",
        "migrations/**",
        "src/lib/db/**",
        "scripts/db-*"
      ]
    }
  ],
  "defaultPaths": [
    "$dbGlobs"
  ]
}
