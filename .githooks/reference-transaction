#!/usr/bin/env bash
# house reference-transaction dispatcher.
#
# Managed by house: `house render` writes this file and .house/lock.json
# records it, so a local edit is reported as tamper. Put your own hooks in
# .githooks/reference-transaction.d/ instead; every file there runs in name
# order, gets the same arguments and the same stdin, and the first one to exit
# non-zero aborts the ref transaction.
#
# git calls this hook only from 2.28 on. On an older git it is inert and the
# pre-commit and pre-push guards are the whole floor; `house doctor` reports
# which of the two this machine has.
#
# A file in the .d directory is skipped when its name starts with `.` or ends
# in `~`, `.disabled` or `.sample`. A file that is not executable is still run
# (with bash) and named in a warning: githooks(5) ignores a non-executable
# hook silently, and a silently ignored guard is a guard that fails open.
#
# Bash 3.2 compatible. See ADR 0013 and issue #58.
set -u

HOUSE_GITHOOKS_DIR=$(cd "$(dirname "$0")" && pwd)
export HOUSE_GITHOOKS_DIR
hook_name=$(basename "$0")
hook_dir="$HOUSE_GITHOOKS_DIR/$hook_name.d"

[ -d "$hook_dir" ] || exit 0

# Sort by byte value, not by locale, so 10- before 20- everywhere.
LC_ALL=C
export LC_ALL

# git feeds reference-transaction its ref lines on stdin, which can only be
# read once. Read them here and hand every hook the same copy.
payload=$(cat)

for f in "$hook_dir"/*; do
  [ -f "$f" ] || continue
  case "$f" in
    *'~' | *.disabled | *.sample) continue ;;
  esac
  cmd=("$f")
  if [ ! -x "$f" ]; then
    printf 'house %s: %s is not executable; running it with bash. Fix: chmod +x %s\n' \
      "$hook_name" "$f" "$f" >&2
    cmd=(bash "$f")
  fi
  rc=0
  if [ -n "$payload" ]; then
    printf '%s\n' "$payload" | "${cmd[@]}" "$@" || rc=$?
  else
    "${cmd[@]}" "$@" </dev/null || rc=$?
  fi
  [ "$rc" -eq 0 ] || exit "$rc"
done

exit 0
