#!/usr/bin/env bash
# Pre-commit: refuse to stage secret CONTENT (a key pasted into an ordinary
# file), the check 20-secrets cannot make because it reads paths only.
#
# It runs the house scanner over the staged blobs: named key formats (AWS,
# GitHub, Slack, Stripe, Google, Anthropic, OpenAI, a PEM header) plus every
# value in .dev.vars. It reads no working tree and does no network I/O, so it
# stays fast. A key format outside its rule list still gets through; CI scans
# full history with the same scanner and is the gate. That is why a missing
# node or scanner only warns here.
#
# Runs from .githooks/pre-commit.d/ beside 20-secrets. This copy is yours:
# house writes it once and never again. A known false positive is waived with
# a line in .house/secret-allow ("<path-glob> <rule-name>  # reason"), not by
# editing this file.
#
# Escape hatch — use it deliberately, not by habit:
#   git commit --no-verify

set -euo pipefail

top=$(git rev-parse --show-toplevel)
scanner="$top/scripts/house/scan-dist-secrets.mjs"

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, so staged content was not scanned for secrets (CI still scans history)." >&2
  exit 0
fi
if [ ! -f "$scanner" ]; then
  echo "pre-commit: $scanner is missing, so staged content was not scanned for secrets (run: house render --apply)." >&2
  exit 0
fi

node "$scanner" --staged
